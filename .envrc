export MAMBA_ROOT_PREFIX="${MAMBA_ROOT_PREFIX:-$HOME/.local/share/mamba}"
export PYTHONNOUSERSITE=1

if command -v watch_file >/dev/null 2>&1; then
    watch_file environment.yml
    watch_file pyproject.toml
fi

if ! command -v micromamba >/dev/null 2>&1; then
    echo "micromamba is required for this repo. Install micromamba or activate contextsafe-hsd manually." >&2
    exit 1
fi

eval "$(micromamba shell hook --shell bash)"
micromamba activate contextsafe-hsd
